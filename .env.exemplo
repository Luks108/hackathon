# Copie para .env (cp .env.exemplo .env). O .env NUNCA vai para o git nem para nenhum canal público.
# Dados fictícios, para desenvolvimento sem a captura real. Guia completo: docs/rodar-no-windows-e-no-linux.md

# ---------- Grafo e consultas (obrigatórias) ----------
NEO4J_SENHA=troque-esta-senha
CHAVE_PF=troque-esta-chave
NEO4J_URI=bolt://127.0.0.1:7689
BRUTO=fixtures/exemplo/bruto

# ---------- Worker do chat (obrigatória para o chat do site e o WhatsApp) ----------
# Mesmo valor de WORKER_KEY em site/hackathon-config.php. Mínimo de 24 caracteres.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_KEY=troque-por-uma-chave-longa-e-aleatoria
# Site que o worker atende. Sem esta linha, ele aponta para o site publicado. Local:
API_BASE=http://127.0.0.1:8080

# ---------- Opcionais ----------
# O perfil normalmente é definido por consulta/perfis.py, não aqui.
# TRANSPARENCIA_LOG=logs/consultas.jsonl
# AGENTE_MODELO=claude-opus-5-5
# AGENTES_SITE=3
# AGENTE_LIMITE_S=110
# AGENTE_PYTHON=/caminho/para/python
# CLAUDE_BIN=/caminho/para/claude
# WHATSAPP_STATE_DIR=/caminho/para/a/pasta/de/estado
